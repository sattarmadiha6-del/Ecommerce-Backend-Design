<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= typeof product !== 'undefined' ? product.name : 'Product Detail' %> – Brand</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#333;background:#f5f5f5;}
a{text-decoration:none;color:inherit;}
img{max-width:100%;display:block;}
.top-nav{background:#fff;border-bottom:1px solid #e8e8e8;padding:10px 0;}
.top-nav .wrap{display:flex;align-items:center;gap:12px;max-width:1200px;margin:0 auto;padding:0 16px;}
.logo{display:flex;align-items:center;gap:6px;font-weight:700;font-size:18px;color:#1a73e8;white-space:nowrap;}
.logo-icon{width:28px;height:28px;background:#1a73e8;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;}
.search-bar{flex:1;display:flex;border:1px solid #d0d0d0;border-radius:4px;overflow:hidden;}
.search-bar input{flex:1;padding:8px 12px;border:none;outline:none;font-size:13px;}
.search-bar select{border:none;border-left:1px solid #e0e0e0;padding:0 10px;background:#f8f8f8;font-size:12px;outline:none;cursor:pointer;}
.search-bar button{background:#1a73e8;color:#fff;border:none;padding:8px 22px;font-size:13px;cursor:pointer;font-weight:500;}
.search-bar button:hover{background:#1565c0;}
.top-icons{display:flex;gap:20px;}
.top-icon{display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;color:#555;font-size:11px;}
.top-icon svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.5;}
.top-icon:hover{color:#1a73e8;}
.sec-nav{background:#fff;border-bottom:1px solid #e8e8e8;padding:8px 0;}
.sec-nav .wrap{display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto;padding:0 16px;}
.sec-left{display:flex;gap:24px;align-items:center;}
.sec-left a{font-size:13px;color:#333;}
.sec-left a:hover{color:#1a73e8;}
.all-cat{display:flex;align-items:center;gap:5px;font-weight:500;}
.sec-right{display:flex;gap:16px;font-size:12px;color:#555;}
.breadcrumb{max-width:1200px;margin:12px auto 0;padding:0 16px;}
.breadcrumb span{font-size:13px;color:#888;}
.breadcrumb a:hover{color:#1a73e8;}
.sep{margin:0 6px;}
.current{color:#333;}
.product-top{max-width:1200px;margin:12px auto 0;padding:0 16px;}
.product-top-inner{background:#fff;border:1px solid #e8e8e8;border-radius:8px;padding:20px;display:grid;grid-template-columns:260px 1fr 240px;gap:24px;}
.gallery{}
.main-img{width:100%;aspect-ratio:1;background:#f8f8f8;border:1px solid #e8e8e8;border-radius:6px;overflow:hidden;margin-bottom:10px;}
.main-img img{width:100%;height:100%;object-fit:cover;}
.thumb-row{display:flex;gap:8px;flex-wrap:wrap;}
.thumb{width:52px;height:52px;border:2px solid #e0e0e0;border-radius:4px;overflow:hidden;cursor:pointer;transition:border-color .2s;}
.thumb img{width:100%;height:100%;object-fit:cover;}
.thumb:hover,.thumb.active{border-color:#1a73e8;}
.in-stock{color:#26a541;font-size:13px;font-weight:500;margin-bottom:8px;display:flex;align-items:center;gap:4px;}
.out-stock{color:#f44336;font-size:13px;font-weight:500;margin-bottom:8px;}
.prod-title{font-size:20px;font-weight:700;color:#1a1a1a;margin-bottom:10px;line-height:1.3;}
.rating-row{display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap;}
.stars{display:flex;gap:1px;}
.star-f{color:#ffc107;font-size:14px;}
.star-e{color:#ddd;font-size:14px;}
.rating-num{font-size:13px;font-weight:600;color:#333;}
.reviews-link,.sold-count{font-size:12px;color:#888;display:flex;align-items:center;gap:3px;}
.price-tiers{display:flex;border:1px solid #e8e8e8;border-radius:6px;overflow:hidden;margin-bottom:14px;}
.tier{flex:1;padding:10px 12px;text-align:center;border-right:1px solid #e8e8e8;background:#fff;}
.tier:last-child{border-right:none;}
.tier.active{background:#fff9f0;}
.tier-price{font-size:16px;font-weight:700;color:#f44336;display:block;margin-bottom:2px;}
.tier-price.normal{color:#222;}
.tier-qty{font-size:11px;color:#888;}
.specs-table{width:100%;margin-bottom:12px;}
.specs-table tr td{padding:6px 0;font-size:13px;vertical-align:top;}
.specs-table tr td:first-child{color:#888;width:110px;padding-right:10px;}
.specs-table tr td:last-child{color:#333;font-weight:500;}
.spec-divider{border:none;border-top:1px solid #f0f0f0;margin:8px 0;}
.add-cart-row{display:flex;gap:10px;align-items:center;margin-top:14px;}
.qty-input{width:80px;border:1px solid #e0e0e0;border-radius:4px;padding:9px 10px;font-size:14px;outline:none;text-align:center;}
.btn-add-cart{background:#1a73e8;color:#fff;border:none;padding:10px 24px;border-radius:4px;font-size:14px;font-weight:500;cursor:pointer;flex:1;}
.btn-add-cart:hover{background:#1565c0;}
.btn-buy-now{background:#ff9800;color:#fff;border:none;padding:10px 20px;border-radius:4px;font-size:14px;font-weight:500;cursor:pointer;}
.btn-buy-now:hover{background:#f57c00;}
.supplier-box{background:#fff;border:1px solid #e8e8e8;border-radius:6px;padding:16px;}
.supplier-avatar{width:40px;height:40px;background:#1a73e8;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:#fff;}
.supplier-name{font-size:14px;font-weight:600;color:#222;margin-bottom:2px;}
.supplier-sub{font-size:12px;color:#888;}
.supplier-meta{margin-top:12px;padding-top:12px;border-top:1px solid #f0f0f0;}
.sup-row{display:flex;align-items:center;gap:8px;margin-bottom:6px;font-size:13px;color:#555;}
.sup-row svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.5;min-width:16px;}
.green{color:#26a541;}
.btn-inquiry{display:block;width:100%;background:#1a73e8;color:#fff;border:none;padding:10px;border-radius:4px;font-size:13px;font-weight:500;cursor:pointer;text-align:center;margin-top:12px;margin-bottom:8px;}
.btn-inquiry:hover{background:#1565c0;}
.btn-profile{display:block;width:100%;background:#fff;border:1px solid #1a73e8;color:#1a73e8;padding:9px;border-radius:4px;font-size:13px;cursor:pointer;text-align:center;margin-bottom:12px;}
.btn-profile:hover{background:#e8f0fe;}
.save-later-btn{display:flex;align-items:center;justify-content:center;gap:6px;color:#1a73e8;font-size:13px;cursor:pointer;background:none;border:none;width:100%;}
.save-later-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.5;}
.save-later-btn:hover{text-decoration:underline;}
.content-area{max-width:1200px;margin:16px auto 0;padding:0 16px;display:grid;grid-template-columns:1fr 220px;gap:16px;align-items:start;}
.tabs-box{background:#fff;border:1px solid #e8e8e8;border-radius:6px;overflow:hidden;}
.tab-nav{display:flex;border-bottom:1px solid #e8e8e8;}
.tab-btn{padding:12px 20px;font-size:14px;color:#888;cursor:pointer;border-bottom:2px solid transparent;background:none;border-top:none;border-left:none;border-right:none;font-family:inherit;}
.tab-btn.active{color:#1a73e8;border-bottom-color:#1a73e8;font-weight:500;}
.tab-btn:hover{color:#1a73e8;}
.tab-content{padding:20px;}
.tab-panel{display:none;}
.tab-panel.active{display:block;}
.tab-panel p{font-size:13px;color:#555;line-height:1.8;margin-bottom:14px;}
.detail-table{width:100%;border-collapse:collapse;margin:14px 0;}
.detail-table tr:nth-child(odd){background:#f9f9f9;}
.detail-table td{padding:9px 14px;font-size:13px;border:1px solid #f0f0f0;}
.detail-table td:first-child{color:#888;width:130px;}
.detail-table td:last-child{color:#333;font-weight:500;}
.feature-list{margin-top:12px;}
.feature-item{display:flex;align-items:center;gap:8px;padding:5px 0;font-size:13px;color:#555;}
.feature-item::before{content:"✓";color:#1a73e8;font-weight:700;}
.review-item{border-bottom:1px solid #f0f0f0;padding:14px 0;}
.review-item:last-child{border-bottom:none;}
.review-header{display:flex;align-items:center;gap:10px;margin-bottom:6px;}
.review-avatar{width:32px;height:32px;background:#e8f0fe;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;color:#1a73e8;font-weight:600;}
.review-name{font-size:13px;font-weight:600;color:#222;}
.review-date{font-size:12px;color:#888;}
.review-text{font-size:13px;color:#555;line-height:1.6;}
.sidebar-box{background:#fff;border:1px solid #e8e8e8;border-radius:6px;padding:16px;}
.sidebar-box h4{font-size:14px;font-weight:600;margin-bottom:14px;color:#222;}
.like-item{display:flex;gap:10px;align-items:center;margin-bottom:12px;cursor:pointer;padding-bottom:12px;border-bottom:1px solid #f5f5f5;}
.like-item:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0;}
.like-img{width:50px;height:50px;min-width:50px;border-radius:4px;overflow:hidden;background:#f5f5f5;}
.like-img img{width:100%;height:100%;object-fit:cover;}
.like-info p{font-size:13px;color:#333;margin-bottom:3px;line-height:1.3;}
.like-info span{font-size:12px;color:#888;}
.related-section{max-width:1200px;margin:16px auto 0;padding:0 16px;}
.related-box{background:#fff;border:1px solid #e8e8e8;border-radius:6px;padding:16px;}
.related-box h3{font-size:15px;font-weight:600;margin-bottom:14px;color:#222;}
.related-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;}
.rel-card{border:1px solid #e8e8e8;border-radius:6px;overflow:hidden;cursor:pointer;transition:box-shadow .2s;}
.rel-card:hover{box-shadow:0 2px 8px rgba(0,0,0,.08);}
.rel-img{width:100%;height:110px;overflow:hidden;background:#f5f5f5;}
.rel-img img{width:100%;height:100%;object-fit:cover;}
.rel-info{padding:8px;}
.rel-info p{font-size:12px;color:#333;margin-bottom:3px;font-weight:500;}
.rel-info span{font-size:12px;color:#888;}
.promo-wrap{max-width:1200px;margin:16px auto 0;padding:0 16px;}
.promo-inner{background:linear-gradient(135deg,#1565c0,#1a73e8,#2196f3);border-radius:8px;padding:28px 36px;display:flex;justify-content:space-between;align-items:center;}
.promo-inner h3{font-size:20px;font-weight:700;color:#fff;margin-bottom:4px;}
.promo-inner p{font-size:13px;color:rgba(255,255,255,.8);}
.btn-shop{background:#ff9800;color:#fff;border:none;padding:12px 28px;border-radius:4px;font-size:14px;font-weight:600;cursor:pointer;}
.btn-shop:hover{background:#f57c00;}
footer{background:#fff;margin-top:20px;padding:28px 0 0;border-top:1px solid #e8e8e8;}
.footer-grid{max-width:1200px;margin:0 auto 24px;padding:0 16px;display:grid;grid-template-columns:220px repeat(4,1fr) 160px;gap:24px;}
.footer-brand p{font-size:12px;color:#888;margin-top:8px;line-height:1.6;}
.footer-social{display:flex;gap:8px;margin-top:10px;}
.soc{width:28px;height:28px;border-radius:50%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-size:11px;cursor:pointer;color:#555;}
.soc:hover{background:#1a73e8;color:#fff;}
.footer-col h4{font-size:14px;font-weight:600;margin-bottom:10px;color:#222;}
.footer-col a{display:block;font-size:13px;color:#666;margin-bottom:7px;}
.footer-col a:hover{color:#1a73e8;}
.app-badges{display:flex;flex-direction:column;gap:8px;}
.app-badge{background:#000;color:#fff;border-radius:6px;padding:7px 12px;display:flex;align-items:center;gap:8px;cursor:pointer;}
.app-badge svg{width:18px;height:18px;fill:#fff;}
.ab-text{font-size:9px;opacity:.7;display:block;}
.ab-name{font-size:12px;font-weight:600;display:block;}
.footer-bottom{border-top:1px solid #e8e8e8;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;max-width:1200px;margin:0 auto;}
.footer-bottom p{font-size:12px;color:#888;}
.footer-bottom select{border:1px solid #e0e0e0;padding:4px 8px;border-radius:4px;font-size:12px;background:#fff;outline:none;}
</style>
</head>
<body>

<!-- TOP NAV -->
<div class="top-nav">
  <div class="wrap">
    <a href="/" class="logo"><div class="logo-icon">B</div>Brand</a>
    <form action="/products" method="GET" class="search-bar">
      <input type="text" name="search" placeholder="Search"/>
      <select name="category">
        <option value="">All category</option>
        <option value="electronics">Electronics</option>
        <option value="fashion">Fashion</option>
        <option value="home">Home</option>
      </select>
      <button type="submit">Search</button>
    </form>
    <div class="top-icons">
      <div class="top-icon" onclick="location.href='/login'">
        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Profile
      </div>
      <div class="top-icon" onclick="location.href='/cart'">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        My cart
      </div>
    </div>
  </div>
</div>

<!-- SEC NAV -->
<div class="sec-nav">
  <div class="wrap">
    <div class="sec-left">
      <a href="/products" class="all-cat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        All category
      </a>
      <a href="/products">Hot offers</a>
      <a href="/products">Gift boxes</a>
      <a href="/products">Projects</a>
      <a href="#">Help ▾</a>
    </div>
    <div class="sec-right"><span>English, USD ▾</span><span>Ship to 🇩🇪 ▾</span></div>
  </div>
</div>

<!-- BREADCRUMB -->
<div class="breadcrumb">
  <span><a href="/">Home</a></span><span class="sep">›</span>
  <% if(product){ %>
    <span><a href="/products?category=<%= product.category %>"><%= product.category %></a></span><span class="sep">›</span>
    <span class="current"><%= product.name %></span>
  <% } else { %>
    <span class="current">Product Detail</span>
  <% } %>
</div>

<!-- PRODUCT TOP -->
<div class="product-top">
  <div class="product-top-inner">

    <!-- GALLERY -->
    <div class="gallery">
      <div class="main-img">
        <img src="<%= product && product.image ? product.image : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&q=80' %>" alt="<%= product ? product.name : 'Product' %>" id="mainImgEl"/>
      </div>
      <div class="thumb-row">
        <%
        const fallbackThumbs = [
          'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100&q=80',
          'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=100&q=80',
          'https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=100&q=80',
          'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=100&q=80',
          'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=100&q=80'
        ];
        const mainSrc = product && product.image ? product.image : fallbackThumbs[0];
        fallbackThumbs.forEach(function(src, i){ %>
          <div class="thumb <%= i===0 ? 'active' : '' %>" onclick="changeImg('<%= src %>', this)">
            <img src="<%= src %>" alt="thumb"/>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- PRODUCT INFO -->
    <div class="prod-info">
      <% if(product && product.stock > 0){ %>
        <div class="in-stock">✅ In stock</div>
      <% } else { %>
        <div class="out-stock">❌ Out of stock</div>
      <% } %>

      <h1 class="prod-title"><%= product ? product.name : 'Product Name' %></h1>

      <div class="rating-row">
        <div class="stars">
          <% for(let i=1;i<=5;i++){ %>
            <span class="<%= i<=(product && product.rating ? product.rating : 4) ? 'star-f' : 'star-e' %>">★</span>
          <% } %>
        </div>
        <span class="rating-num"><%= product && product.rating ? product.rating : 4 %></span>
        <span class="reviews-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          <%= reviews ? reviews.length : 0 %> reviews
        </span>
        <span class="sold-count">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          <%= product && product.orderCount ? product.orderCount : 0 %> sold
        </span>
      </div>

      <!-- PRICE TIERS -->
      <div class="price-tiers">
        <div class="tier active">
          <span class="tier-price">$<%= product ? product.price : '0' %></span>
          <span class="tier-qty">50-100 pcs</span>
        </div>
        <div class="tier">
          <span class="tier-price normal">$<%= product ? Math.round(product.price * 0.92) : '0' %></span>
          <span class="tier-qty">100-700 pcs</span>
        </div>
        <div class="tier">
          <span class="tier-price normal">$<%= product ? Math.round(product.price * 0.80) : '0' %></span>
          <span class="tier-qty">700+ pcs</span>
        </div>
      </div>

      <!-- SPECS -->
      <table class="specs-table">
        <tr><td>Price:</td><td>Negotiable</td></tr>
        <tr><td><hr class="spec-divider"/></td><td><hr class="spec-divider"/></td></tr>
        <tr><td>Category:</td><td><%= product ? product.category : '-' %></td></tr>
        <tr><td>Stock:</td><td><%= product ? product.stock : '-' %> units</td></tr>
        <tr><td><hr class="spec-divider"/></td><td><hr class="spec-divider"/></td></tr>
        <tr><td>Warranty:</td><td>2 years full warranty</td></tr>
        <tr><td>Protection:</td><td>Refund Policy</td></tr>
      </table>

      <!-- ADD TO CART -->
      <% if(product && product.stock > 0){ %>
        <form action="/cart/add" method="POST" class="add-cart-row">
          <input type="hidden" name="productId" value="<%= product._id %>"/>
          <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" class="qty-input"/>
          <button type="submit" class="btn-add-cart">Add to cart</button>
          <button type="submit" name="buyNow" value="true" class="btn-buy-now">Buy now</button>
        </form>
      <% } else { %>
        <div class="add-cart-row">
          <button class="btn-add-cart" style="opacity:0.5;cursor:not-allowed;" disabled>Out of Stock</button>
        </div>
      <% } %>
    </div>

    <!-- SUPPLIER BOX -->
    <div class="supplier-box">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
        <div class="supplier-avatar">
          <%= product && product.category ? product.category.charAt(0).toUpperCase() : 'S' %>
        </div>
        <div>
          <div class="supplier-name">Supplier</div>
          <div class="supplier-sub">Guanjoi Trading LLC</div>
        </div>
      </div>
      <div class="supplier-meta">
        <div class="sup-row">🇩🇪 Germany, Berlin</div>
        <div class="sup-row">
          <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span class="green">Verified Seller</span>
        </div>
        <div class="sup-row">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          Worldwide shipping
        </div>
      </div>
      <button class="btn-inquiry">Send inquiry</button>
      <a href="/products" class="btn-profile">Seller's profile</a>
      <button class="save-later-btn">
        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        Save for later
      </button>
    </div>

  </div>
</div>

<!-- TABS + SIDEBAR -->
<div class="content-area">
  <div class="tabs-box">
    <div class="tab-nav">
      <button class="tab-btn active" onclick="switchTab(this,'desc')">Description</button>
      <button class="tab-btn" onclick="switchTab(this,'reviews')">Reviews (<%= reviews ? reviews.length : 0 %>)</button>
      <button class="tab-btn" onclick="switchTab(this,'shipping')">Shipping</button>
      <button class="tab-btn" onclick="switchTab(this,'seller')">About seller</button>
    </div>
    <div class="tab-content">

      <!-- DESCRIPTION -->
      <div class="tab-panel active" id="desc">
        <p><%= product && product.description ? product.description : 'No description available for this product.' %></p>
        <table class="detail-table">
          <tr><td>Model</td><td>#<%= product ? product._id.toString().slice(-6).toUpperCase() : 'N/A' %></td></tr>
          <tr><td>Category</td><td><%= product ? product.category : '-' %></td></tr>
          <tr><td>Stock</td><td><%= product ? product.stock : '-' %> units</td></tr>
          <tr><td>Rating</td><td><%= product ? product.rating : '-' %> / 5</td></tr>
        </table>
        <div class="feature-list">
          <div class="feature-item">High quality product with premium materials</div>
          <div class="feature-item">Fast worldwide shipping available</div>
          <div class="feature-item">2 year full warranty included</div>
          <div class="feature-item">Bulk order discounts available</div>
        </div>
      </div>

      <!-- REVIEWS -->
      <div class="tab-panel" id="reviews">
        <% if(reviews && reviews.length > 0){ %>
          <% reviews.forEach(function(review){ %>
            <div class="review-item">
              <div class="review-header">
                <div class="review-avatar"><%= review.user ? review.user.charAt(0).toUpperCase() : 'U' %></div>
                <div>
                  <div class="review-name"><%= review.user || 'Anonymous' %></div>
                  <div class="review-date"><%= review.date ? new Date(review.date).toLocaleDateString() : '' %></div>
                </div>
                <div class="stars" style="margin-left:auto;">
                  <% for(let i=1;i<=5;i++){ %><span class="<%= i<=review.rating ? 'star-f':'star-e' %>">★</span><% } %>
                </div>
              </div>
              <div class="review-text"><%= review.comment %></div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="review-item">
            <div class="review-header">
              <div class="review-avatar">J</div>
              <div><div class="review-name">John D.</div><div class="review-date">Jan 2024</div></div>
              <div class="stars" style="margin-left:auto;"><span class="star-f">★</span><span class="star-f">★</span><span class="star-f">★</span><span class="star-f">★</span><span class="star-f">★</span></div>
            </div>
            <div class="review-text">Great product, fast shipping! Highly recommend.</div>
          </div>
          <div class="review-item">
            <div class="review-header">
              <div class="review-avatar">S</div>
              <div><div class="review-name">Sarah M.</div><div class="review-date">Feb 2024</div></div>
              <div class="stars" style="margin-left:auto;"><span class="star-f">★</span><span class="star-f">★</span><span class="star-f">★</span><span class="star-f">★</span><span class="star-e">★</span></div>
            </div>
            <div class="review-text">Good quality, fits as described.</div>
          </div>
        <% } %>
      </div>

      <!-- SHIPPING -->
      <div class="tab-panel" id="shipping">
        <p>Free worldwide shipping on orders over $50.</p>
        <p>Estimated delivery: 7–14 business days depending on your location.</p>
        <p>Express shipping available at checkout for faster delivery.</p>
      </div>

      <!-- ABOUT SELLER -->
      <div class="tab-panel" id="seller">
        <p>Guanjoi Trading LLC — Verified seller based in Germany, Berlin.</p>
        <p>Member since 2018 · 99.2% positive feedback · 12,400+ orders completed.</p>
      </div>

    </div>
  </div>

  <!-- YOU MAY LIKE -->
  <div class="sidebar-box">
    <h4>You may like</h4>
    <% if(similarProducts && similarProducts.length > 0){ %>
      <% similarProducts.slice(0,5).forEach(function(p){ %>
        <div class="like-item" onclick="location.href='/product/<%= p._id %>'">
          <div class="like-img">
            <img src="<%= p.image ? p.image : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100&q=80' %>" alt="<%= p.name %>"/>
          </div>
          <div class="like-info">
            <p><%= p.name %></p>
            <span>$<%= p.price %></span>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="like-item">
        <div class="like-img"><img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100&q=80" alt="watch"/></div>
        <div class="like-info"><p>Smart Watch Premium</p><span>$99.00</span></div>
      </div>
      <div class="like-item">
        <div class="like-img"><img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=100&q=80" alt="headphones"/></div>
        <div class="like-info"><p>Wireless Headphones</p><span>$79.00</span></div>
      </div>
      <div class="like-item">
        <div class="like-img"><img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=100&q=80" alt="laptop"/></div>
        <div class="like-info"><p>Laptop Pro 15"</p><span>$999.00</span></div>
      </div>
      <div class="like-item">
        <div class="like-img"><img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=100&q=80" alt="shoes"/></div>
        <div class="like-info"><p>Sports Running Shoes</p><span>$120.00</span></div>
      </div>
      <div class="like-item">
        <div class="like-img"><img src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=100&q=80" alt="camera"/></div>
        <div class="like-info"><p>DSLR Camera 24MP</p><span>$599.00</span></div>
      </div>
    <% } %>
  </div>
</div>

<!-- RELATED PRODUCTS -->
<div class="related-section">
  <div class="related-box">
    <h3>Related products</h3>
    <div class="related-grid">
      <% if(relatedProducts && relatedProducts.length > 0){ %>
        <% relatedProducts.slice(0,6).forEach(function(p){ %>
          <div class="rel-card" onclick="location.href='/product/<%= p._id %>'">
            <div class="rel-img">
              <img src="<%= p.image ? p.image : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=200&q=80' %>" alt="<%= p.name %>"/>
            </div>
            <div class="rel-info">
              <p><%= p.name %></p>
              <span>$<%= p.price %></span>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <%
        const relFallback = [
          {img:'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=200&q=80',name:'Smart Watch',price:'$99'},
          {img:'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=200&q=80',name:'Headphones',price:'$79'},
          {img:'https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=200&q=80',name:'Laptop',price:'$999'},
          {img:'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=200&q=80',name:'Shoes',price:'$120'},
          {img:'https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=200&q=80',name:'Camera',price:'$599'},
          {img:'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=200&q=80',name:'Backpack',price:'$49'}
        ];
        relFallback.forEach(function(r){ %>
          <div class="rel-card" onclick="location.href='/products'">
            <div class="rel-img"><img src="<%= r.img %>" alt="<%= r.name %>"/></div>
            <div class="rel-info"><p><%= r.name %></p><span><%= r.price %></span></div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<!-- PROMO BANNER -->
<div class="promo-wrap">
  <div class="promo-inner">
    <div><h3>Super discount on more than 100 USD</h3><p>Shop more and save more on your favorite items</p></div>
    <button class="btn-shop" onclick="location.href='/products'">Shop now</button>
