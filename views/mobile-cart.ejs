<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Shopping Cart – Brand</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#333;background:#fff;max-width:480px;margin:0 auto;}
a{text-decoration:none;color:inherit;}
img{max-width:100%;display:block;}

/* TOP NAV */
.top-nav{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid #f0f0f0;}
.back-btn{font-size:20px;cursor:pointer;color:#333;}
.page-title{font-size:16px;font-weight:700;flex:1;}

/* CART ITEMS */
.cart-list{padding:0 16px;}
.cart-item{padding:16px 0;border-bottom:1px solid #f5f5f5;}
.cart-item-top{display:flex;gap:12px;margin-bottom:10px;}
.item-img{width:70px;height:70px;min-width:70px;border-radius:8px;overflow:hidden;background:#f8f8f8;}
.item-img img{width:100%;height:100%;object-fit:cover;}
.item-details{flex:1;}
.item-name{font-size:13px;font-weight:500;color:#222;margin-bottom:4px;line-height:1.4;}
.item-meta{font-size:12px;color:#888;margin-bottom:2px;}
.item-seller{font-size:12px;color:#888;}
.item-dots{color:#ccc;font-size:18px;cursor:pointer;align-self:flex-start;}
.item-bottom{display:flex;align-items:center;justify-content:space-between;}
.qty-controls{display:flex;align-items:center;gap:0;border:1px solid #e0e0e0;border-radius:6px;overflow:hidden;}
.qty-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:18px;color:#333;background:#fff;border:none;font-weight:300;}
.qty-val{width:40px;text-align:center;font-size:14px;font-weight:600;border:none;outline:none;background:#fff;}
.item-price{font-size:16px;font-weight:700;color:#222;}

/* SUMMARY */
.summary{padding:16px;border-top:1px solid #f0f0f0;margin-top:4px;}
.summary-row{display:flex;justify-content:space-between;margin-bottom:8px;font-size:13px;color:#888;}
.summary-row .val{color:#333;}
.summary-total{display:flex;justify-content:space-between;padding-top:10px;border-top:1px solid #f0f0f0;margin-top:4px;}
.summary-total .label{font-size:15px;font-weight:600;color:#222;}
.summary-total .amount{font-size:18px;font-weight:700;color:#222;}

/* CHECKOUT BTN */
.checkout-wrap{padding:12px 16px 20px;}
.btn-checkout{display:block;width:100%;background:#00b517;color:#fff;border:none;padding:14px;border-radius:8px;font-size:15px;font-weight:600;text-align:center;cursor:pointer;text-decoration:none;}
.btn-checkout:hover{background:#009914;}

/* SAVED FOR LATER */
.saved-section{background:#f9f9f9;padding:16px;}
.saved-title{font-size:15px;font-weight:700;color:#222;margin-bottom:12px;}
.saved-item{background:#fff;border:1px solid #f0f0f0;border-radius:10px;padding:12px;display:flex;gap:12px;margin-bottom:10px;}
.saved-img{width:60px;height:60px;min-width:60px;border-radius:6px;overflow:hidden;background:#f8f8f8;}
.saved-img img{width:100%;height:100%;object-fit:cover;}
.saved-details{flex:1;}
.saved-name{font-size:13px;font-weight:500;color:#222;margin-bottom:4px;}
.saved-price{font-size:14px;font-weight:700;color:#222;margin-bottom:8px;}
.saved-actions{display:flex;gap:8px;}
.btn-move{padding:6px 14px;border:1.5px solid #1a73e8;color:#1a73e8;border-radius:6px;font-size:12px;cursor:pointer;background:#fff;font-weight:500;}
.btn-remove{padding:6px 14px;border:1.5px solid #f44336;color:#f44336;border-radius:6px;font-size:12px;cursor:pointer;background:#fff;font-weight:500;}
</style>
</head>
<body>

<!-- TOP NAV -->
<div class="top-nav">
  <span class="back-btn" onclick="history.back()">←</span>
  <span class="page-title">Shopping cart</span>
</div>

<!-- CART ITEMS -->
<div class="cart-list">
  <% if(cartItems && cartItems.length > 0){ %>
    <% cartItems.forEach(function(item){ %>
      <div class="cart-item" id="item-<%= item._id %>">
        <div class="cart-item-top">
          <div class="item-img">
            <img
              src="<%= item.product && item.product.image ? item.product.image : 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=200' %>"
              alt="<%= item.product ? item.product.name : 'Product' %>"/>
          </div>
          <div class="item-details">
            <div class="item-name"><%= item.product ? item.product.name : 'Product' %></div>
            <div class="item-meta">Size: medium, Color: blue</div>
            <div class="item-seller">Seller: <%= item.seller || 'Brand Store' %></div>
          </div>
          <span class="item-dots">⋮</span>
        </div>
        <div class="item-bottom">
          <div class="qty-controls">
            <button class="qty-btn">−</button>
            <input class="qty-val" type="number" value="<%= item.quantity %>" min="1" max="20"/>
            <button class="qty-btn">+</button>
          </div>
          <div class="item-price">
            $<%= item.product ? (item.product.price * item.quantity).toFixed(2) : '0.00' %>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div style="text-align:center;padding:60px 20px;color:#888;">
      <p style="font-size:16px;margin-bottom:12px;">🛒 Your cart is empty</p>
      <a href="/mobile-items" style="color:#1a73e8;">Start shopping</a>
    </div>
  <% } %>
</div>

<!-- SUMMARY -->
<% if(cartItems && cartItems.length > 0){ %>
<div class="summary">
  <div class="summary-row">
    <span>Items (<%= cartItems.length %>):</span>
    <span class="val">$<%= typeof subtotal === 'number' ? subtotal.toFixed(2) : subtotal %></span>
  </div>
  <div class="summary-row">
    <span>Shipping:</span>
    <span class="val">$10.00</span>
  </div>
  <div class="summary-row">
    <span>Tax:</span>
    <span class="val">$<%= typeof tax === 'number' ? tax.toFixed(2) : tax %></span>
  </div>
  <div class="summary-total">
    <span class="label">Total:</span>
    <span class="amount">$<%= typeof total === 'number' ? total.toFixed(2) : total %></span>
  </div>
</div>

<div class="checkout-wrap">
  <a href="/checkout" class="btn-checkout">
    Checkout (<%= cartItems.length %> items)
  </a>
</div>
<% } %>

<!-- SAVED FOR LATER -->
<% if(savedItems && savedItems.length > 0){ %>
<div class="saved-section">
  <div class="saved-title">Saved for later</div>
  <% savedItems.forEach(function(item){ %>
    <div class="saved-item">
      <div class="saved-img">
        <img
          src="<%= item.product && item.product.image ? item.product.image : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=200' %>"
          alt="<%= item.product ? item.product.name : 'Product' %>"/>
      </div>
      <div class="saved-details">
        <div class="saved-name"><%= item.product ? item.product.name : 'Product' %></div>
        <div class="saved-price">$<%= item.product ? item.product.price.toFixed(2) : '0.00' %></div>
        <div class="saved-actions">
          <button class="btn-move">Move to cart</button>
          <button class="btn-remove">Remove</button>
        </div>
      </div>
    </div>
  <% }); %>
</div>
<% } %>

</body>
</html>