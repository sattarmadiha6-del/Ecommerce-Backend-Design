<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Admin – Products</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Segoe UI',Arial,sans-serif;background:#f5f5f5;font-size:14px;}
.navbar{background:#1a73e8;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;}
.navbar .brand{color:#fff;font-size:18px;font-weight:700;text-decoration:none;}
.navbar .nav-right{display:flex;align-items:center;gap:16px;}
.navbar a{color:rgba(255,255,255,0.85);text-decoration:none;font-size:13px;}
.navbar a:hover{color:#fff;}
.navbar .logout{background:rgba(255,255,255,0.15);padding:6px 14px;border-radius:4px;}
.wrap{max-width:1100px;margin:24px auto;padding:0 16px;}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
.page-header h1{font-size:22px;font-weight:700;color:#222;}
.alert{padding:12px 16px;border-radius:4px;margin-bottom:16px;font-size:13px;}
.alert.success{background:#f0fdf4;border:1px solid #86efac;color:#166534;}
.alert.error{background:#fef2f2;border:1px solid #fecaca;color:#dc2626;}
.grid{display:grid;grid-template-columns:380px 1fr;gap:20px;align-items:start;}
.card{background:#fff;border:1px solid #e8e8e8;border-radius:8px;padding:20px;}
.card h2{font-size:16px;font-weight:600;color:#222;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid #f0f0f0;}
.form-group{margin-bottom:14px;}
.form-group label{display:block;font-size:12px;font-weight:600;color:#555;margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}
.form-group input,
.form-group select,
.form-group textarea{width:100%;padding:9px 12px;border:1px solid #e0e0e0;border-radius:4px;font-size:13px;outline:none;font-family:inherit;}
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{border-color:#1a73e8;}
.form-group textarea{resize:vertical;min-height:80px;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.checkbox-row{display:flex;align-items:center;gap:8px;padding:4px 0;}
.checkbox-row input{width:16px;height:16px;accent-color:#1a73e8;cursor:pointer;}
.checkbox-row label{font-size:13px;color:#333;cursor:pointer;font-weight:normal;text-transform:none;letter-spacing:0;}
.btn-add{width:100%;background:#1a73e8;color:#fff;border:none;padding:11px;border-radius:4px;font-size:14px;font-weight:600;cursor:pointer;margin-top:4px;}
.btn-add:hover{background:#1565c0;}
.img-preview{width:100%;height:140px;background:#f8f8f8;border:1px solid #e0e0e0;border-radius:4px;margin-top:8px;overflow:hidden;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:12px;}
.img-preview img{width:100%;height:100%;object-fit:cover;}
.products-table{width:100%;border-collapse:collapse;}
.products-table th{background:#f8f8f8;padding:10px 12px;text-align:left;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;border-bottom:1px solid #e8e8e8;}
.products-table td{padding:12px;border-bottom:1px solid #f0f0f0;font-size:13px;vertical-align:middle;}
.products-table tr:last-child td{border-bottom:none;}
.products-table tr:hover td{background:#fafafa;}
.prod-img-cell{width:50px;height:50px;border-radius:4px;overflow:hidden;background:#f5f5f5;}
.prod-img-cell img{width:100%;height:100%;object-fit:cover;}
.badge{display:inline-block;padding:3px 8px;border-radius:20px;font-size:11px;font-weight:600;}
.badge.electronics{background:#e8f0fe;color:#1a73e8;}
.badge.fashion{background:#fce4ec;color:#c2185b;}
.badge.home{background:#e8f5e9;color:#2e7d32;}
.badge.accessories{background:#fff3e0;color:#e65100;}
.badge.sports{background:#f3e5f5;color:#7b1fa2;}
.badge.default{background:#f5f5f5;color:#555;}
.btn-del{background:#fff;border:1px solid #fecaca;color:#dc2626;padding:5px 12px;border-radius:4px;font-size:12px;cursor:pointer;}
.btn-del:hover{background:#fef2f2;}
.empty-state{text-align:center;padding:40px;color:#888;}
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;}
.stat-card{background:#fff;border:1px solid #e8e8e8;border-radius:8px;padding:16px;text-align:center;}
.stat-card .num{font-size:28px;font-weight:700;color:#1a73e8;}
.stat-card .lbl{font-size:12px;color:#888;margin-top:4px;}
</style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar">
  <a href="/" class="brand">🛍 Brand Admin</a>
  <div class="nav-right">
    <a href="/">🏠 View Store</a>
    <a href="/products">📦 Products</a>
    <span style="color:rgba(255,255,255,0.7);font-size:13px;">👤 <%= user.name %></span>
    <a href="/logout" class="logout">Logout</a>
  </div>
</nav>

<div class="wrap">

  <!-- PAGE HEADER -->
  <div class="page-header">
    <h1>Product Management</h1>
    <span style="color:#888;font-size:13px;">Total: <%= products.length %> products</span>
  </div>

  <!-- ALERTS -->
  <% if(success){ %>
    <div class="alert success">✅ <%= success %></div>
  <% } %>
  <% if(error){ %>
    <div class="alert error">❌ <%= error %></div>
  <% } %>

  <!-- STATS -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="num"><%= products.length %></div>
      <div class="lbl">Total Products</div>
    </div>
    <div class="stat-card">
      <div class="num"><%= products.filter(p => p.stock > 0).length %></div>
      <div class="lbl">In Stock</div>
    </div>
    <div class="stat-card">
      <div class="num"><%= products.filter(p => p.stock === 0).length %></div>
      <div class="lbl">Out of Stock</div>
    </div>
  </div>

  <div class="grid">

    <!-- ADD PRODUCT FORM -->
    <div class="card">
      <h2>➕ Add New Product</h2>
      <form action="/admin/products/add" method="POST">

        <div class="form-group">
          <label>Product Name *</label>
          <input type="text" name="name" placeholder="e.g. Smart Watch Pro" required/>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Price ($) *</label>
            <input type="number" name="price" placeholder="99" step="0.01" min="0" required/>
          </div>
          <div class="form-group">
            <label>Old Price ($)</label>
            <input type="number" name="oldPrice" placeholder="129" step="0.01" min="0"/>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Category *</label>
            <select name="category" required>
              <option value="">Select...</option>
              <option value="electronics">Electronics</option>
              <option value="fashion">Fashion</option>
              <option value="home">Home</option>
              <option value="accessories">Accessories</option>
              <option value="sports">Sports</option>
            </select>
          </div>
          <div class="form-group">
            <label>Stock (units)</label>
            <input type="number" name="stock" placeholder="50" min="0"/>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Rating (0-5)</label>
            <input type="number" name="rating" placeholder="4" min="0" max="5" step="0.1"/>
          </div>
          <div class="form-group">
            <label>Free Shipping</label>
            <div class="checkbox-row" style="margin-top:8px;">
              <input type="checkbox" name="freeShipping" id="freeShipping"/>
              <label for="freeShipping">Yes, free shipping</label>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Image URL</label>
          <input type="text" name="image" id="imageUrl" placeholder="https://images.unsplash.com/..." oninput="previewImg(this.value)"/>
          <div class="img-preview" id="imgPreview">
            <span>Image preview will appear here</span>
          </div>
        </div>

        <div class="form-group">
          <label>Description</label>
          <textarea name="description" placeholder="Enter product description..."></textarea>
        </div>

        <button type="submit" class="btn-add">➕ Add Product</button>
      </form>
    </div>

    <!-- PRODUCTS LIST -->
    <div class="card">
      <h2>📦 All Products</h2>
      <% if(products.length > 0){ %>
        <table class="products-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Name</th>
              <th>Price</th>
              <th>Category</th>
              <th>Stock</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function(p){ %>
              <tr>
                <td>
                  <div class="prod-img-cell">
                    <img src="<%= p.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100' %>" alt="<%= p.name %>"/>
                  </div>
                </td>
                <td><strong><%= p.name %></strong></td>
                <td>$<%= p.price.toFixed(2) %></td>
                <td>
                  <span class="badge <%= p.category || 'default' %>">
                    <%= p.category %>
                  </span>
                </td>
                <td><%= p.stock %></td>
                <td>
                  <form action="/admin/products/delete/<%= p._id %>" method="POST" onsubmit="return confirm('Delete this product?')">
                    <button type="submit" class="btn-del">🗑 Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <p>No products yet.</p>
          <a href="/add-products" style="color:#1a73e8;margin-top:8px;display:inline-block;">
            Click here to add sample products
          </a>
        </div>
      <% } %>
    </div>

  </div>
</div>

<script>
function previewImg(url) {
  const preview = document.getElementById('imgPreview');
  if (url) {
    preview.innerHTML = '<img src="' + url + '" onerror="this.parentElement.innerHTML=\'<span>Invalid image URL</span>\'">';
  } else {
    preview.innerHTML = '<span>Image preview will appear here</span>';
  }
}
</script>
</body>
</html>