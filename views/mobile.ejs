<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
<title>Brand – Mobile</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#333;background:#f5f5f5;max-width:480px;margin:0 auto;}
a{text-decoration:none;color:inherit;}
.top-nav{background:#fff;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e8e8e8;position:sticky;top:0;z-index:100;}
.logo{display:flex;align-items:center;gap:6px;font-weight:700;font-size:17px;color:#1a73e8;}
.nav-right{display:flex;align-items:center;gap:16px;}
.nav-icon{cursor:pointer;color:#333;font-size:20px;}
.search-wrap{background:#fff;padding:10px 16px;border-bottom:1px solid #f0f0f0;}
.search-box{display:flex;align-items:center;gap:8px;background:#f5f5f5;border-radius:8px;padding:9px 14px;}
.search-box input{background:none;border:none;outline:none;font-size:14px;color:#333;width:100%;}
.hero-banner{background:linear-gradient(135deg,#e8f5e9,#b2dfdb);margin:12px;border-radius:12px;padding:24px 20px;display:flex;justify-content:space-between;align-items:center;}
.hero-text h3{font-size:13px;color:#666;margin-bottom:4px;}
.hero-text h2{font-size:18px;font-weight:700;color:#1a1a1a;margin-bottom:14px;}
.btn-learn{background:#fff;border:1px solid #ccc;padding:7px 16px;border-radius:6px;font-size:12px;cursor:pointer;}
.hero-emoji{font-size:60px;}
.section{background:#fff;margin-top:12px;padding:16px;}
.section-title{font-size:16px;font-weight:700;color:#222;margin-bottom:14px;}
.prod-scroll{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;}
.prod-scroll::-webkit-scrollbar{display:none;}
.prod-card{min-width:120px;flex-shrink:0;cursor:pointer;text-decoration:none;}
.prod-img{width:120px;height:100px;background:#f5f5f5;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:40px;margin-bottom:6px;overflow:hidden;}
.prod-img img{width:100%;height:100%;object-fit:cover;border-radius:8px;}
.prod-name{font-size:12px;color:#333;font-weight:500;margin-bottom:2px;}
.prod-price{font-size:12px;color:#1a73e8;font-weight:600;}
.rec-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.rec-card{background:#fff;border:1px solid #e8e8e8;border-radius:8px;overflow:hidden;cursor:pointer;text-decoration:none;}
.rec-img{width:100%;height:130px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;font-size:50px;overflow:hidden;}
.rec-img img{width:100%;height:100%;object-fit:cover;}
.rec-info{padding:10px;}
.rec-price{font-size:14px;font-weight:700;color:#222;margin-bottom:3px;}
.rec-name{font-size:12px;color:#888;line-height:1.3;}
.page-bottom{height:70px;}
.bottom-nav{background:#fff;border-top:1px solid #e8e8e8;position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;display:flex;padding:8px 0 12px;}
.bnav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;color:#aaa;font-size:10px;text-decoration:none;}
.bnav-item.active{color:#1a73e8;}
</style>
</head>
<body>
<div class="top-nav">
  <div class="logo">🛍️ Brand</div>
  <div class="nav-right">
    <a href="/mobile-cart" class="nav-icon">🛒</a>
    <span class="nav-icon">👤</span>
  </div>
</div>
<div class="search-wrap">
  <form action="/mobile-items" method="GET">
    <div class="search-box">
      <span>🔍</span>
      <input type="text" name="search" placeholder="Search..."/>
    </div>
  </form>
</div>
<div class="hero-banner">
  <div class="hero-text">
    <h3>Latest trending</h3>
    <h2>Electronic<br/>items</h2>
    <button class="btn-learn">Learn more</button>
  </div>
  <div class="hero-emoji">🎧</div>
</div>
<div class="section">
  <div class="section-title">Featured Products</div>
  <div class="prod-scroll">
    <% products.forEach(function(product){ %>
      <a href="/detail/<%= product._id %>" class="prod-card">
        <div class="prod-img">
          <% if(product.image){ %>
            <img src="<%= product.image %>" alt="<%= product.name %>"/>
          <% } else { %>
            📦
          <% } %>
        </div>
        <div class="prod-name"><%= product.name %></div>
        <div class="prod-price">$<%= product.price %></div>
      </a>
    <% }) %>
  </div>
</div>
<div class="section">
  <div class="section-title">Recommended items</div>
  <div class="rec-grid">
    <% products.slice(0,4).forEach(function(product){ %>
      <a href="/detail/<%= product._id %>" class="rec-card">
        <div class="rec-img">
          <% if(product.image){ %>
            <img src="<%= product.image %>" alt="<%= product.name %>"/>
          <% } else { %>
            📦
          <% } %>
        </div>
        <div class="rec-info">
          <div class="rec-price">$<%= product.price %></div>
          <div class="rec-name"><%= product.name %></div>
        </div>
      </a>
    <% }) %>
  </div>
</div>
<div class="page-bottom"></div>
<div class="bottom-nav">
  <a href="/mobile" class="bnav-item active">🏠<span>Home</span></a>
  <a href="/mobile-items" class="bnav-item">🔍<span>Explore</span></a>
  <a href="/mobile-cart" class="bnav-item">🛒<span>Cart</span></a>
  <a href="#" class="bnav-item">❤️<span>Wishlist</span></a>
  <a href="#" class="bnav-item">👤<span>Account</span></a>
</div>
</body>
</html>