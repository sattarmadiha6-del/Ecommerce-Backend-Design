<script>
function updateTimer(){
  const blocks=document.querySelectorAll('.timer-block span');
  if(blocks.length<4)return;
  let[d,h,m,s]=[parseInt(blocks[0].textContent),parseInt(blocks[1].textContent),parseInt(blocks[2].textContent),parseInt(blocks[3].textContent)];
  s--;if(s<0){s=59;m--;}if(m<0){m=59;h--;}if(h<0){h=23;d--;}if(d<0){d=0;h=0;m=0;s=0;}
  blocks[0].textContent=String(d).padStart(2,'0');
  blocks[1].textContent=String(h).padStart(2,'0');
  blocks[2].textContent=String(m).padStart(2,'0');
  blocks[3].textContent=String(s).padStart(2,'0');
}
setInterval(updateTimer,1000);
</script>
